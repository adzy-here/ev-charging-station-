*.sqlite3
*.db
*.dump
*.sql.gz

# Editors and operating systems
.vscode/
.idea/
.DS_Store
Thumbs.db
Desktop.ini

# Build/package artifacts (keep project assets in dist/ tracked)
build/
.eggs/
*.egg-info/
.wheels/
dist-new/

# Frontend package artifacts, if added later
node_modules/
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Local test and coverage output
.tox/
.nox/

